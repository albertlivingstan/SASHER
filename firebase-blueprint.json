{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with adaptive calibration preferences and authentication metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID from Firebase Auth",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Verified Google user email",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL",
          "maxLength": 512
        },
        "calibrationScore": {
          "type": "number",
          "description": "Eye-tracking accuracy calibration percentage (0-100)"
        },
        "savedPreferences": {
          "type": "array",
          "description": "List of aesthetic and fashion category preferences"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp string of account creation",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp string of last profile update",
          "maxLength": 64
        }
      },
      "required": ["id", "email", "displayName"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Product saved to the user wishlist with adaptive context",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Unique product ID",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "User UID who added item to wishlist",
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "description": "Product name",
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "maxLength": 64
        },
        "price": {
          "type": "number",
          "description": "Product price in USD"
        },
        "addedAt": {
          "type": "string",
          "description": "Timestamp string when product was wishlisted",
          "maxLength": 64
        }
      },
      "required": ["productId", "userId", "productName", "category", "price"]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "Completed checkout order record with total and item count",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique order ID",
          "maxLength": 64
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order identifier",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "totalAmount": {
          "type": "number",
          "description": "Total purchase amount in USD"
        },
        "itemCount": {
          "type": "number",
          "description": "Quantity of items ordered"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method used (e.g. google_pay, apple_pay, card)",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Order processing status",
          "enum": ["completed", "processing"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string when order was placed",
          "maxLength": 64
        }
      },
      "required": ["orderId", "orderNumber", "userId", "totalAmount", "itemCount", "paymentMethod", "status"]
    },
    "SessionState": {
      "title": "SessionState",
      "description": "Persistent adaptive session state across devices",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID owning this session state",
          "maxLength": 128
        },
        "primaryCategory": {
          "type": "string",
          "description": "Top trend category detected by attention model",
          "maxLength": 64
        },
        "confidence": {
          "type": "number",
          "description": "Session intent confidence score between 0 and 1"
        },
        "totalInteractions": {
          "type": "number",
          "description": "Cumulative interactions processed in session"
        },
        "trendDescription": {
          "type": "string",
          "description": "Human-readable intent trend summary",
          "maxLength": 256
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when state was last synced",
          "maxLength": 64
        }
      },
      "required": ["userId", "primaryCategory", "confidence", "totalInteractions"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile collection indexed by authenticated user UID"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": {
        "$ref": "#/entities/WishlistItem"
      },
      "description": "User wishlist items subcollection"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/UserOrder"
      },
      "description": "User completed checkout orders subcollection"
    },
    "/users/{userId}/session/{docId}": {
      "schema": {
        "$ref": "#/entities/SessionState"
      },
      "description": "User adaptive session state subcollection"
    }
  }
}
