{
  "system_title": "A Session-Aware Hybrid Recommender System for Cold-Start Mitigation in Indian E-Commerce",
  "version": "1.0.0",
  "description": "External configuration file defining default numerical weights and threshold parameters for the SASHER hybrid recommendation engine.",
  "weights": {
    "CF_WEIGHT": 0.25,
    "CBF_WEIGHT": 0.25,
    "SESSION_WEIGHT": 0.25,
    "POPULARITY_WEIGHT": 0.15,
    "COLD_START_WEIGHT": 0.10
  },
  "thresholds": {
    "user_cold_start_threshold": 3,
    "item_cold_start_threshold": 5,
    "session_dwell_threshold_seconds": 1.2,
    "session_decay_lambda": 0.05,
    "mmr_diversity_lambda": 0.70,
    "session_inactivity_timeout_minutes": 30,
    "minimum_confidence_threshold": 0.20
  },
  "cold_start": {
    "user_interaction_threshold": 3,
    "item_interaction_threshold": 5,
    "new_user_strategy": "hybrid_cbf_popularity_session",
    "new_item_strategy": "attribute_similarity_multimodal",
    "new_session_strategy": "trending_regional_category_priors"
  },
  "interaction_weights": {
    "view": 1.0,
    "hover": 1.2,
    "click": 2.0,
    "wishlist": 4.0,
    "cart": 5.0,
    "purchase": 8.0,
    "eye_gaze": 3.5,
    "feedback_like": 3.0,
    "feedback_dislike": -3.0
  },
  "session": {
    "decay_lambda": 0.05,
    "max_recent_items": 10,
    "dwell_threshold_seconds": 1.2
  },
  "indian_ecommerce": {
    "currency": "INR",
    "festive_boost": 1.25,
    "regional_categories": [
      "Sarees",
      "Kurtas",
      "Sherwanis",
      "Lehengas",
      "Indo-Western",
      "Handloom",
      "Bandhani",
      "Chikankari"
    ],
    "price_sensitivity": {
      "budget_max": 2500,
      "contemporary_max": 8000,
      "luxury_min": 8000
    }
  },
  "ranking": {
    "top_k": 12,
    "candidate_pool_size": 36,
    "diversity_lambda_mmr": 0.7
  },
  "parameter_schema": {
    "weights": {
      "CF_WEIGHT": {
        "type": "float",
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "description": "Collaborative filtering weight modeling latent user-item co-occurrence."
      },
      "CBF_WEIGHT": {
        "type": "float",
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "description": "Content-based filtering weight modeling multi-attribute textile and silhouette vectors."
      },
      "SESSION_WEIGHT": {
        "type": "float",
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "description": "Session-aware weight capturing short-term intent and real-time ocular gaze dwell."
      },
      "POPULARITY_WEIGHT": {
        "type": "float",
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "description": "Popularity prior weight reflecting global star ratings and verified purchases."
      },
      "COLD_START_WEIGHT": {
        "type": "float",
        "default": 0.10,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "description": "Dedicated cold-start mitigation weight bootstrapping recommendations for new users and items."
      }
    },
    "thresholds": {
      "user_cold_start_threshold": {
        "type": "integer",
        "default": 3,
        "min": 1,
        "max": 20,
        "description": "Interaction count below which a user is classified as NEW_USER."
      },
      "item_cold_start_threshold": {
        "type": "integer",
        "default": 5,
        "min": 1,
        "max": 50,
        "description": "Historical interaction count below which an item is classified as NEW_ITEM."
      },
      "session_dwell_threshold_seconds": {
        "type": "float",
        "default": 1.2,
        "min": 0.4,
        "max": 5.0,
        "description": "Minimum visual gaze fixation duration to trigger an explicit EYE_GAZE interest signal."
      },
      "session_decay_lambda": {
        "type": "float",
        "default": 0.05,
        "min": 0.001,
        "max": 0.5,
        "description": "Exponential recency decay constant lambda for session event weighting."
      }
    }
  },
  "external_modification": {
    "allows_runtime_overrides": true,
    "environment_variable_prefix": "SASHER_CONFIG_",
    "config_source": "recommendation_config.json",
    "hot_reload": true
  }
}
